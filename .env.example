APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=letter-message
DB_USERNAME=postgres
DB_PASSWORD=

ROOM_BOOKING_SELF_WITHDRAWAL_CUTOFF_HOURS=24
ROOM_BOOKING_IDEMPOTENCY_RETENTION_HOURS=168
ROOM_BOOKING_MUTATION_RATE_LIMIT_PER_MINUTE=20

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

LETTER_RETENTION_ENABLED=false
LETTER_RETENTION_SCHEDULE_TIME=02:30
LETTER_RETENTION_BATCH_SIZE=100
LETTER_RETENTION_ON_ONE_SERVER=true
SUPPORTING_DOCUMENT_RETENTION_DAYS=14
IMPORT_BATCH_PURGE_ENABLED=false
IMPORT_BATCH_PURGE_TIME=03:15
INTERMEDIATE_ARTIFACT_RETENTION_DAYS=14
FINAL_PDF_ACTIVE_DAYS=30
LETTER_ARCHIVE_DISK=archive
FINAL_PDF_ARCHIVE_RETENTION_DAYS=365

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Local SMTP capture example (Mailpit): MAIL_MAILER=smtp, host 127.0.0.1, port 1025.
# Production/staging SMTP values must be supplied through environment secrets.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="Sistem Persuratan DTEDI"

# Forgot-password OTP policy. Simulation is local-only, disabled by default,
# and must never be enabled in staging or production.
PASSWORD_RESET_SIMULATION=false
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_REQUEST_WINDOW_SECONDS=600
PASSWORD_RESET_EMAIL_MAX_REQUESTS=5
PASSWORD_RESET_IP_MAX_REQUESTS=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TEMPLATE_BEASISWA_ID=

# Google OAuth (GIS ID-token flow)
# This app uses Google Identity Services (GIS). Only GOOGLE_CLIENT_ID is used at
# runtime — the backend verifies ID tokens via googleapis.com/tokeninfo and checks
# the 'aud' claim against this value. GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI
# are loaded by config/services.php but NOT used by any application code; they are
# kept here as empty keys for forward compatibility.
#
# Get the shared Client ID from the team lead via private message.
# See SETUP_GUIDE.md § "Google OAuth (UGM SSO) Setup" for details.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
